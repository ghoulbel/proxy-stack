# Copy to .env and fill in real values. Never commit .env.

# --- Traefik dashboard ------------------------------------------------------
# Basic auth in front of the Traefik dashboard. Only needed until the dashboard
# sits behind Authentik forward-auth, which is the direction this goes.
DASHBOARD_USER=<your-username>

# htpasswd hash, NOT the password itself:
#   docker run --rm -it httpd:2.4-alpine htpasswd -nbBC 10 "" 'your-password'
DASHBOARD_PASSWORD_HASH=

# --- Let's Encrypt DNS-01 ---------------------------------------------------
# Cloudflare API token. Scope it to the single zone and the two permissions
# Traefik actually needs:
#   Zone:DNS:Edit      (create the _acme-challenge TXT records)
#   Zone:Zone:Read     (Traefik reads the zone to find the authoritative NS)
# A token cannot be scoped to "only this TXT record", so keep it to one zone.
CF_DNS_API_TOKEN=
# Copy to .env and fill in real values. Never commit .env.

# --- Traefik dashboard ------------------------------------------------------
# Basic auth in front of the Traefik dashboard. Only needed until the dashboard
# sits behind Authentik forward-auth, which is the direction this goes.
DASHBOARD_USER=<your-username>

# htpasswd hash, NOT the password itself:
#   docker run --rm -it httpd:2.4-alpine htpasswd -nbBC 10 "" 'your-password'
DASHBOARD_PASSWORD_HASH=

# --- Let's Encrypt DNS-01 ---------------------------------------------------
# Cloudflare API token. Scope it to the single zone and the two permissions
# Traefik actually needs:
#   Zone:DNS:Edit      (create the _acme-challenge TXT records)
#   Zone:Zone:Read     (Traefik reads the zone to find the authoritative NS)
# A token cannot be scoped to "only this TXT record", so keep it to one zone.
CF_DNS_API_TOKEN=
# --- Pip per-app accounts (children's story app) ----------------------------
# Comma separated htpasswd list, bcrypt cost 10:
#   PIP_AUTH_USERS=alice:$$2y$$10$$<hash>,bob:$$2y$$10$$<hash>
# Every "$" is DOUBLED because Docker Compose eats a single one and the hash
# silently becomes garbage (the login then always 401s with the right password).
# Generate a pair with:
#   docker run --rm httpd:alpine htpasswd -nbBC 10 <name> '<password>'
# then paste "<name>:$$2y$$10$$<hash>" into the list.
# Add an account: append to this line, then `docker compose up -d`.
# Remove one:      delete its "<name>:$$2y$$10$$<hash>" entry (leave the rest).
# Full instructions: ai-project/pip-story-friend/README.md
PIP_AUTH_USERS=
